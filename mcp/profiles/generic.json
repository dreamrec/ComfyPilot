{
  "mcpServers": {
    "comfypilot": {
      "command": "uv",
      "args": ["run", "--directory", "/path/to/ComfyPilot", "comfypilot"],
      "env": {
        "COMFY_URL": "http://127.0.0.1:8188",
        "COMFY_API_KEY": "",
        "COMFY_AUTH_METHOD": "auto",
        "COMFY_TIMEOUT": "300",
        "COMFY_SNAPSHOT_LIMIT": "50",
        "COMFY_SNAPSHOT_DIR": "",
        "COMFY_BLUEPRINT_DIR": "~/.comfypilot/blueprints",
        "COMFY_OUTPUT_DIR": "~/comfypilot_output",
        "COMFY_TD_OUTPUT_DIR": "~/comfypilot_output/touchdesigner",
        "COMFY_BLENDER_OUTPUT_DIR": "~/comfypilot_output/blender"
      }
    }
  }
}
