{
  "id": "ltx2-txt2video",
  "name": "ltx2-txt2video",
  "description": "LTX-2 text-to-video baseline. 768x512 at 121 frames, 25fps.",
  "tags": ["ltx", "ltx-2", "txt2video", "video", "fast"],
  "node_count": 10,
  "nodes": {
    "1": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "ltx-video-2b-v0.9.safetensors"}},
    "2": {"class_type": "CLIPTextEncode", "inputs": {"text": "a time-lapse of clouds over a mountain", "clip": ["1", 1]}},
    "3": {"class_type": "CLIPTextEncode", "inputs": {"text": "low quality, flicker", "clip": ["1", 1]}},
    "4": {"class_type": "LTXVConditioning", "inputs": {"positive": ["2", 0], "negative": ["3", 0], "frame_rate": 25}},
    "5": {"class_type": "EmptyLTXVLatentVideo", "inputs": {"width": 768, "height": 512, "length": 121, "batch_size": 1}},
    "6": {"class_type": "LTXVScheduler", "inputs": {"steps": 30, "max_shift": 2.05, "base_shift": 0.95, "stretch": true, "terminal": 0.1, "latent": ["5", 0]}},
    "7": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler"}},
    "8": {"class_type": "SamplerCustom", "inputs": {"model": ["1", 0], "positive": ["4", 0], "negative": ["4", 1], "sampler": ["7", 0], "sigmas": ["6", 0], "latent_image": ["5", 0], "add_noise": true, "noise_seed": 42, "cfg": 3.0}},
    "9": {"class_type": "VAEDecode", "inputs": {"samples": ["8", 0], "vae": ["1", 2]}},
    "10": {"class_type": "SaveAnimatedWEBP", "inputs": {"images": ["9", 0], "filename_prefix": "ComfyPilot_ltx2", "fps": 25, "quality": 80}}
  }
}
