{
  "id": "hunyuan-video-txt2video",
  "name": "hunyuan-video-txt2video",
  "description": "HunyuanVideo 1.5 text-to-video baseline. 720x480 at 73 frames, 24fps output.",
  "tags": ["hunyuan", "hunyuanvideo", "txt2video", "video"],
  "node_count": 12,
  "nodes": {
    "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "hunyuan-video-t2v-720p.safetensors", "weight_dtype": "default"}},
    "2": {"class_type": "DualCLIPLoader", "inputs": {"clip_name1": "llava_llama3_fp16.safetensors", "clip_name2": "clip_l.safetensors", "type": "hunyuan_video"}},
    "3": {"class_type": "VAELoader", "inputs": {"vae_name": "hunyuan_video_vae_bf16.safetensors"}},
    "4": {"class_type": "CLIPTextEncode", "inputs": {"text": "a character walking through a neon-lit alley at night", "clip": ["2", 0]}},
    "5": {"class_type": "EmptyHunyuanLatentVideo", "inputs": {"width": 720, "height": 480, "length": 73, "batch_size": 1}},
    "6": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler"}},
    "7": {"class_type": "BasicScheduler", "inputs": {"model": ["1", 0], "scheduler": "simple", "steps": 30, "denoise": 1.0}},
    "8": {"class_type": "RandomNoise", "inputs": {"noise_seed": 42}},
    "9": {"class_type": "BasicGuider", "inputs": {"model": ["1", 0], "conditioning": ["4", 0]}},
    "10": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["8", 0], "guider": ["9", 0], "sampler": ["6", 0], "sigmas": ["7", 0], "latent_image": ["5", 0]}},
    "11": {"class_type": "VAEDecode", "inputs": {"samples": ["10", 0], "vae": ["3", 0]}},
    "12": {"class_type": "SaveAnimatedWEBP", "inputs": {"images": ["11", 0], "filename_prefix": "ComfyPilot_hyv", "fps": 24, "quality": 80}}
  }
}
